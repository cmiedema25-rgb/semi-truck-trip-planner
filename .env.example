# OpenRouteService API key (free at https://openrouteservice.org/dev/#/signup)
# Enables live HGV / truck routing and geocoding.
ORS_API_KEY=

# Optional: default home terminal / yard origin when --from is omitted
TRUCKPLAN_HOME_ORIGIN=1234 Trucking Way, Dallas, TX 75201

# Optional: use mock provider even if ORS_API_KEY is set (for demos)
# TRUCKPLAN_FORCE_MOCK=1

# Optional LLM summarization (not required; template summary works offline)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
