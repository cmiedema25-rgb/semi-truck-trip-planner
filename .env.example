# OpenRouteService API key (free at https://openrouteservice.org/dev/#/signup)
# Enables live HGV / truck routing and geocoding for long-haul lanes.
ORS_API_KEY=

# Optional: default home terminal / yard (long-haul origin when --from omitted)
TRUCKPLAN_HOME_ORIGIN=1200 Commerce Dr, Ontario, CA 91761

# Optional: use mock provider even if ORS_API_KEY is set (for demos / CI)
# TRUCKPLAN_FORCE_MOCK=1

# Optional LLM summarization (not required)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
